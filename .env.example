# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development

# Long random string used to sign login sessions. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=8h
DB_PATH=data/anareen.db
TZ_NAME=Asia/Kolkata
HOSPITAL_NAME=Anareen Lifecare Hospital

# Hours during which patients can book today's token online (24-hour clock)
BOOKING_OPEN=06:00
BOOKING_CLOSE=19:00

# Privacy: patient names and mobile numbers are deleted from bookings older than this
RETENTION_DAYS=30

# Daily database backups (also: npm run backup). Keeps the newest BACKUP_KEEP days.
BACKUP_DIR=backups
BACKUP_KEEP=14

# Server errors are written here with timestamps. Leave empty to turn file logging off.
LOG_FILE=logs/error.log

# Running behind nginx / Caddy / a load balancer that handles HTTPS:
#   TRUST_PROXY = number of proxies in front of the app (1 for a single nginx). Use 0 if the
#                 app is reached directly, so visitors can't fake their IP for rate limits.
#   FORCE_HTTPS = true redirects plain-HTTP visits to HTTPS.
# With NODE_ENV=production, login cookies are sent over HTTPS only.
TRUST_PROXY=1
FORCE_HTTPS=false
